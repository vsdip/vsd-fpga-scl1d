{
  "name": "VSD FPGA SCL1D",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "openfpga_user",
  "overrideCommand": false,
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "FPGA noVNC Desktop",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "VSD_FPGA_ROOT": "${containerWorkspaceFolder}",
    "SCL1D_PDK_ROOT": "${containerWorkspaceFolder}/pdk/local"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "mshr-h.veriloghdl",
        "surfer-project.surfer"
      ]
    }
  },
  "postCreateCommand": "echo 'Codespace ready. Install the SCL PDK, then run: make doctor'"
}
