{
  "name": "VSD FPGA SCL1D",
  "image": "ghcr.io/lnis-uofu/openfpga-master:latest",
  "containerEnv": {
    "VSD_FPGA_ROOT": "${containerWorkspaceFolder}",
    "SCL1D_PDK_ROOT": "${containerWorkspaceFolder}/pdk/local"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "mshr-h.veriloghdl",
        "surfer-project.surfer"
      ]
    }
  },
  "postCreateCommand": "bash -lc 'echo Codespace ready; install the PDK, then run make doctor'",
  "overrideCommand": true
}
